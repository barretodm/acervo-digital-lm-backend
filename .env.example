# Porta do servidor HTTP local
PORT=3333

# Supabase (storage e autenticacao)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conexao com o Postgres do Supabase via connection pooler (Settings > Database
# > Connection pooling, modo Transaction), usada via pg.Pool para as queries
DATABASE_URL=

# Envio de e-mail de notificacao ao galerista (RF06)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
GALERISTA_EMAIL=

# Origem permitida para CORS (frontend)
CORS_ORIGIN=http://localhost:5173
